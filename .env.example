# 실제 값을 채운 뒤 파일명을 .env 로 바꾸세요. (현재 스켈레톤은 MOCK_MODE=1 이라 없어도 동작)
MOCK_MODE=1

# LLM (벤더 중립 — 값은 env 로 주입. 코드에 벤더명·모델명을 박지 않는다)
# 2026-09-13 결정: Bedrock은 쓰지 않는다. [3-C]·[5] 문장 생성은 OpenAI만 쓴다.
# 실제 호출하려면 셋이 다 필요하다: MOCK_MODE=0 · LLM_PROVIDER=openai · LLM_MODEL · OPENAI_API_KEY
LLM_PROVIDER=mock
# 사용할 모델 id (예: gpt-4o-mini). 콘솔에서 실제 쓸 모델을 확인해 넣는다
LLM_MODEL=gpt-4o-mini
# OpenAI API 키. .env 는 .gitignore 이므로 이 예시 파일에는 실제 값을 절대 넣지 않는다
OPENAI_API_KEY=
# 조건 대화 에이전트 (Strands Agents SDK, src/agent/conditions_agent.py). 1 이면 조건 대화의 자유 텍스트를
# LLM 도구 호출로 반영한다 (위 셋이 다 있어야 실제로 켜진다). 기본 0 — 계약 §D-3 합의 전 opt-in.
CONDITIONS_AGENT=0
# 아래 둘은 RAG(임베딩) 쪽 변수다 — [3-C]·[5]의 OpenAI 호출과는 무관하니 비워 둔다.
# 값을 채우면 RAG_EMBEDDING_PROVIDER=bedrock 의 기본 모델(amazon.titan-embed-text-v2:0)을
# 덮어써서 임베딩 호출이 깨질 수 있다 — 채워야 한다면 rag 담당자와 먼저 확인한다.
LLM_REGION=
EMBEDDING_MODEL=

# RAG: default is Bedrock, never silently falls back to local-test.
# Synthetic offline regression only: RAG_EMBEDDING_PROVIDER=local-test
RAG_EMBEDDING_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_PROFILE=your-profile
# EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# RAG_STORAGE_ROOT=.rag-files
# Disposable PostgreSQL integration tests only (never a production DSN):
# RAG_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres?sslmode=disable

# PostgreSQL + pgvector (2번 작업에서 사용)
# DATABASE_URL=postgresql://truefit:truefit@localhost:5432/truefit

# 이메일+비밀번호 로그인 (src/auth, src/services/auth_service.py)
# 운영에서는 반드시 값을 바꾸세요 — 기본값을 그대로 쓰면 토큰 위조가 가능합니다.
JWT_SECRET=dev-only-change-me
# https로 서빙할 때만 1 (평문 http 개발 환경에서 Secure 쿠키는 브라우저가 거부합니다)
COOKIE_SECURE=0
