# 실제 값을 채운 뒤 파일명을 .env 로 바꾸세요. (현재 스켈레톤은 MOCK_MODE=1 이라 없어도 동작)
MOCK_MODE=1

# LLM (벤더 중립 — 값은 env 로 주입. 코드에 벤더명·모델명을 박지 않는다)
# 실제 호출하려면 넷이 다 필요하다: MOCK_MODE=0 · LLM_PROVIDER=openai · LLM_MODEL · OPENAI_API_KEY
LLM_PROVIDER=mock
# 사용할 모델 id (예: gpt-4o-mini). 콘솔에서 실제 쓸 모델을 확인해 넣는다
LLM_MODEL=
# OpenAI API 키. .env 는 .gitignore 이므로 이 예시 파일에는 실제 값을 절대 넣지 않는다
OPENAI_API_KEY=
LLM_REGION=
EMBEDDING_MODEL=

# RAG: default is Bedrock, never silently falls back to local-test.
# Synthetic offline regression only: RAG_EMBEDDING_PROVIDER=local-test
RAG_EMBEDDING_PROVIDER=bedrock
# AWS_REGION=us-east-1
# AWS_PROFILE=your-profile
# EMBEDDING_MODEL=amazon.titan-embed-text-v2:0
# RAG_STORAGE_ROOT=.rag-files
# Disposable PostgreSQL integration tests only (never a production DSN):
# RAG_TEST_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:55432/postgres?sslmode=disable

# PostgreSQL + pgvector (2번 작업에서 사용)
# DATABASE_URL=postgresql://truefit:truefit@localhost:5432/truefit
